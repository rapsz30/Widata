# ==============================================================================
# WIDATA — .gitignore
# ==============================================================================

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Next.js Build Output ──────────────────────────────────────────────────────
.next/
out/
build/

# ── DATABASE — SANGAT PENTING: jangan pernah commit file database! ────────────
prisma/*.db
prisma/*.db-shm
prisma/*.db-wal
*.sqlite
*.sqlite3

# ── Environment Variables — RAHASIA, JANGAN DI-COMMIT! ───────────────────────
# File ini berisi password database, secret key, API key, dll.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging
.env.example

# ── File contoh environment BOLEH di-commit (tidak berisi nilai rahasia) ──────
# .env.example  ← uncomment jika ingin mengecualikan

# ── NextAuth / Auth Secret ────────────────────────────────────────────────────
# Pastikan NEXTAUTH_SECRET tidak pernah hardcoded di kode sumber

# ── Upload & Media ────────────────────────────────────────────────────────────
# Jika di masa depan ada fitur upload file ke server lokal:
uploads/
public/uploads/
storage/

# ── Log Files ─────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS & Editor Files ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── VSCode ────────────────────────────────────────────────────────────────────
# Simpan settings workspace tapi jangan commit settings pribadi
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.pem
*.key
*.cert
.cache/
.turbo/
