generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  nama          String
  username      String            @unique
  password      String
  role          String
  wilayahId     String?
  aktif         Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  laporanDibuat LaporanWarga[]    @relation("PelaporLaporan")
  rekapDibuat   Rekap[]
  wilayah       Wilayah?          @relation(fields: [wilayahId], references: [id])
  usulanDibuat  UsulanPerubahan[] @relation("PengusulUsulan")
}

model Wilayah {
  id           String          @id @default(cuid())
  nama         String
  jenis        String
  kode         String?
  parentId     String?
  createdAt    DateTime        @default(now())
  kkList       KartuKeluarga[]
  laporanWarga LaporanWarga[]
  rekap        Rekap[]
  users        User[]
  parent       Wilayah?        @relation("WilayahHierarki", fields: [parentId], references: [id])
  children     Wilayah[]       @relation("WilayahHierarki")
}

model KartuKeluarga {
  id             String     @id @default(cuid())
  noKK           String     @unique
  kepalaKeluarga String
  alamat         String
  wilayahId      String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  wilayah        Wilayah    @relation(fields: [wilayahId], references: [id])
  anggota        Penduduk[]
}

model Penduduk {
  id            String            @id @default(cuid())
  nik           String            @unique
  nama          String
  tempatLahir   String
  tanggalLahir  DateTime
  jenisKelamin  String
  agama         String
  pendidikan    String
  pekerjaan     String
  statusKawin   String
  statusHidup   String            @default("HIDUP")
  statusTinggal String            @default("TETAP")
  kkId          String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  bpjs          DataBPJS[]
  bansos        DataBansos[]
  laporan       LaporanWarga[]
  kk            KartuKeluarga?    @relation(fields: [kkId], references: [id])
  usulan        UsulanPerubahan[]
}

model LaporanWarga {
  id         String    @id @default(cuid())
  jenis      String
  status     String    @default("PENDING")
  pendudukId String?
  pelaporId  String
  wilayahId  String
  catatan    String?
  dataBaru   String?
  verifiedBy String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  pelapor    User      @relation("PelaporLaporan", fields: [pelaporId], references: [id])
  penduduk   Penduduk? @relation(fields: [pendudukId], references: [id])
  wilayah    Wilayah   @relation(fields: [wilayahId], references: [id])
}

model UsulanPerubahan {
  id         String    @id @default(cuid())
  pendudukId String?
  pengusulId String
  field      String
  nilaiLama  String
  nilaiBaru  String
  alasan     String
  status     String    @default("PENDING")
  verifiedBy String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  penduduk   Penduduk? @relation(fields: [pendudukId], references: [id])
  pengusul   User      @relation("PengusulUsulan", fields: [pengusulId], references: [id])
}

model DataBansos {
  id           String   @id @default(cuid())
  pendudukId   String
  jenisBansos  String
  tahun        Int
  semester     Int
  nilaiManfaat Int
  status       String   @default("AKTIF")
  keterangan   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  penduduk     Penduduk @relation(fields: [pendudukId], references: [id])
}

model DataBPJS {
  id         String   @id @default(cuid())
  pendudukId String
  noKartu    String   @unique
  kelas      Int
  jenis      String
  status     String   @default("AKTIF")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  penduduk   Penduduk @relation(fields: [pendudukId], references: [id])
}

model Rekap {
  id         String   @id @default(cuid())
  wilayahId  String
  bulan      Int
  tahun      Int
  jenis      String
  data       String
  dibuatOleh String
  createdAt  DateTime @default(now())
  pembuat    User     @relation(fields: [dibuatOleh], references: [id])
  wilayah    Wilayah  @relation(fields: [wilayahId], references: [id])
}
